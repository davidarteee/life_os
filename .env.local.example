# ---------------------------------------------------------------------------
# LifeOS environment. Copy this file to `.env.local` and fill in values.
# LifeOS runs fully in LOCAL MODE with NONE of these set — data lives in the
# browser (IndexedDB). Add Supabase to enable accounts + cross-device sync.
# ---------------------------------------------------------------------------

# Supabase (auth + Postgres + Storage). Project Settings → API.
# Public — safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: canonical site URL, used for OAuth redirects in production.
# e.g. https://lifeos.yourdomain.com
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# NEVER expose the service_role key to the browser. It is not used by the
# current client-only build; if you add server-only admin tasks later, put it
# here (server-only, no NEXT_PUBLIC_ prefix) and read it in server code only.
# SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
